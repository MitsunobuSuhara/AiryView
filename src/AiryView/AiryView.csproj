<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>AiryView</AssemblyName>
    <ApplicationIcon>../../assets/icons/AiryView.ico</ApplicationIcon>
    <Version>2.1.57</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- 選択背景を文字の背後に描き、選択中も文字色を維持する。 -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Controls.Text.UseAdornerForTextboxSelectionRendering" Value="false" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="155.0.8044" />
    <Content Include="../../THIRD-PARTY/**/*" Link="THIRD-PARTY/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/checks/*.pdf" Link="Samples/print-check.pdf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/fonts/**/*" Link="Fonts/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../artifacts/helper/airyview-pdf-helper/**/*" Link="Helper/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/icons/AiryView.ico" Link="AiryView.ico" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.20" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
    <Resource Include="../../assets/icons/AiryView.ico" Link="Assets/icon.ico" />
  </ItemGroup>
</Project>
