<Window x:Class="AiryView.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AiryView 2.0.15" Width="1180" Height="840" MinWidth="860" MinHeight="560" Background="#F5F7FA" FontFamily="Yu Gothic UI" FontSize="14" Icon="Assets/icon.ico"
 UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True" Drop="FilesDropped" PreviewKeyDown="WindowKeyDown" Closing="WindowClosing">
 <DockPanel>
  <StackPanel DockPanel.Dock="Top" Background="#F5F7FA">
   <WrapPanel x:Name="DocumentToolbar" Margin="12,5">
    <Button Click="OpenClick" ToolTip="開く / Open&#10;Ctrl+O" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="ファイルを開く" Padding="10,7"><Canvas Width="22" Height="20"><Path Data="M2,16 L2,5 Q2,3 4,3 L9,3 Q10,3 11,4 L13,6 L19,6 Q21,6 21,8" Fill="Transparent" Stroke="#192432" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M2,16 L5,9 Q5.5,8 7,8 L20,8 Q22,8 21.4,10 L19.5,16 Q19,18 17,18 L4,18 Q2,18 2,16 Z" Fill="Transparent" Stroke="#192432" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Button>
    <Button x:Name="SaveTextButton" Visibility="Collapsed" Click="SaveTextClick" ToolTip="保存 / Save&#10;Ctrl+S" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="テキストを保存" Padding="10,7"><Canvas Width="22" Height="20"><Path Data="M3,2 L17,2 L20,5 L20,18 L3,18 Z M6,2 L6,8 L16,8 L16,2 M7,18 L7,13 L16,13 L16,18" Fill="Transparent" Stroke="#192432" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M13,4 L15,4" Stroke="#192432" StrokeThickness="1.6" StrokeStartLineCap="Round"/></Canvas></Button>
    <Button x:Name="MarkdownModeButton" Visibility="Collapsed" Click="MarkdownModeClick" ToolTip="表示を切り替える / Switch Preview–Source&#10;Ctrl+Shift+M" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="MarkdownのPreviewとSourceを切り替える" Padding="9,7"><TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold"/></Button>
    <Button x:Name="PrintButton" Visibility="Collapsed" Click="PrintClick" ToolTip="印刷 / Print&#10;Ctrl+P" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="印刷プレビュー" Padding="10,7"><Canvas Width="22" Height="20"><Path Data="M6,7 L6,2 L16,2 L16,7 M5,15 L3,15 Q2,15 2,14 L2,9 Q2,7 4,7 L18,7 Q20,7 20,9 L20,14 Q20,15 19,15 L17,15" Fill="Transparent" Stroke="#192432" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M6,12 L16,12 L16,18 L6,18 Z M16.5,9.5 L17,9.5" Fill="Transparent" Stroke="#192432" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Button>
    <StackPanel x:Name="PageControls" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="‹" Click="PreviousClick" ToolTip="前のページ / Previous page"/><TextBox x:Name="PageNumber" Text="1" Width="58" FontSize="16" TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" KeyDown="PageNumberKeyDown"/><TextBlock x:Name="PageCount" Text="/ —" MinWidth="42" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" Margin="8,0,12,0"/><Button Content="›" Click="NextClick" ToolTip="次のページ / Next page"/></StackPanel>
    <Button Content="−" Click="ZoomOutClick" ToolTip="縮小 / Zoom out"/><TextBox x:Name="ZoomText" Text="100" Width="66" TextAlignment="Center" VerticalContentAlignment="Center" KeyDown="ZoomInputKeyDown" LostKeyboardFocus="ZoomInputLostFocus" GotKeyboardFocus="ZoomInputGotFocus" ToolTip="表示倍率（10～800％）。入力してEnterで確定" AutomationProperties.Name="表示倍率"/><TextBlock Text="%" VerticalAlignment="Center"/><Button Content="＋" Click="ZoomInClick" ToolTip="拡大 / Zoom in"/>
    <WrapPanel x:Name="RotationControls" Visibility="Collapsed"><Button Content="↶" FontFamily="Segoe UI Symbol" FontSize="21" Padding="10,2" Click="RotateLeftClick" ToolTip="左に90度回転 / Rotate left" AutomationProperties.Name="左に90度回転"/><Button Content="↷" FontFamily="Segoe UI Symbol" FontSize="21" Padding="10,2" Click="RotateRightClick" ToolTip="右に90度回転 / Rotate right" AutomationProperties.Name="右に90度回転"/><Button x:Name="ResetRotationButton" Padding="9,6" Click="ResetRotationClick" ToolTip="回転を元に戻す / Reset rotation" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="回転をリセット"><Canvas Width="20" Height="20"><Path Data="M16,6 A7,7 0 1 0 18,12" Fill="Transparent" Stroke="#192432" StrokeThickness="1.7" StrokeStartLineCap="Round"/><Path Data="M13,3 L17,3 L17,7" Fill="Transparent" Stroke="#192432" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Button></WrapPanel><Button x:Name="FitWidthButton" Visibility="Collapsed" Click="FitClick" ToolTip="画面幅に合わせる / Fit to width" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="画面幅に合わせる" Padding="10,7"><Canvas Width="24" Height="18"><Path Data="M2,2 L2,16 M22,2 L22,16 M5,9 L19,9 M8,6 L5,9 L8,12 M16,6 L19,9 L16,12" Stroke="#192432" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Button>

   </WrapPanel>
   <ScrollViewer x:Name="TabsScroller" Margin="12,0,12,3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
    <StackPanel Orientation="Horizontal">
     <TabControl x:Name="Tabs" SelectionChanged="TabChanged" MinHeight="34"/>
     <Button Content="＋" Click="NewTextClick" ToolTip="新しいメモ / New tab&#10;Ctrl+T" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="新しいメモ" FontSize="20" Width="43" MinHeight="34" Padding="5,0" Margin="2,0,0,0"/>
    </StackPanel>
   </ScrollViewer>
   <DockPanel x:Name="TextSearchBar" Visibility="Collapsed" Margin="12,0,12,6" LastChildFill="False">
    <TextBox x:Name="TextSearchInput" Width="260" Padding="7,4" KeyDown="TextSearchKeyDown" GotKeyboardFocus="TextSearchGotFocus" ToolTip="文章内を検索"/>
    <Button Content="前" Click="PreviousTextMatch" Padding="9,4"/><Button Content="次" Click="NextTextMatch" Padding="9,4"/><TextBlock x:Name="TextSearchCount" VerticalAlignment="Center" Margin="8,0"/><Button Content="×" Click="CloseTextSearch" Padding="9,4" ToolTip="検索を閉じる / Close search"/>
</DockPanel>
   <TextBlock x:Name="Status" Visibility="Collapsed"/>
  </StackPanel>
  <Grid x:Name="ContentGrid" Background="#BCC3CC">
   <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center">
    <Image x:Name="WelcomeCrane" Width="88" Height="88" Stretch="Uniform" Margin="0,0,0,24" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="AiryViewの鶴"/>
    <TextBlock Text="すっと開く。正確に印刷。 / Open with ease. Print with precision." FontSize="25" Foreground="#334155" HorizontalAlignment="Center"/>
    <TextBlock Text="ファイルを開く / Open a file" Margin="0,18,0,0" Foreground="#526173" HorizontalAlignment="Center"/>
    <TextBlock Text="新しいメモ：＋ または Ctrl＋T / New note: ＋ or Ctrl＋T" Margin="0,10,0,0" Foreground="#526173" HorizontalAlignment="Center"/>
   </StackPanel>
   <ScrollViewer x:Name="ImageViewer" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White" PreviewMouseWheel="ImageWheel"><Image x:Name="ReaderImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="ImageClick"/></ScrollViewer>
   <Grid x:Name="TextEditorArea" Visibility="Collapsed">
    <TextBox x:Name="TextEditor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas, Yu Gothic UI" FontSize="15" Padding="28,22" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="TextEditorChanged" SelectionChanged="TextEditorSelectionChanged"/>
   </Grid>
   <FlowDocumentScrollViewer x:Name="MarkdownViewer" Visibility="Collapsed" PreviewMouseWheel="MarkdownWheel" Background="White" VerticalScrollBarVisibility="Auto" IsSelectionEnabled="True" MinZoom="10" MaxZoom="800"/>
   <ScrollViewer x:Name="Viewer" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ViewerWheel" ScrollChanged="ViewerScrolled">
    <StackPanel x:Name="PagesHost" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Top"/>
   </ScrollViewer>
   <Border x:Name="TextSelectionBadge" Visibility="Collapsed" Panel.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,18" Padding="12,6" CornerRadius="11" Background="#EB172033" BorderBrush="#52637A" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.24" Color="#111827"/></Border.Effect>
    <TextBlock x:Name="TextSelectionInfo" Foreground="#F8FAFC" FontFamily="Yu Gothic UI" FontSize="12" FontWeight="SemiBold"/>
   </Border>
  </Grid>
 </DockPanel>
</Window>
