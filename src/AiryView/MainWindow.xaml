<Window x:Class="AiryView.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AiryView 2.1.61" Width="1180" Height="840" MinWidth="860" MinHeight="560" Background="{DynamicResource AirySurface}" FontFamily="Yu Gothic UI" FontSize="14" Icon="Assets/icon.ico"
 WindowStyle="SingleBorderWindow" UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True" Drop="FilesDropped" PreviewKeyDown="WindowKeyDown" Closing="WindowClosing">
 <DockPanel>
  <StackPanel DockPanel.Dock="Top" Background="{DynamicResource AirySurface}">
   <WrapPanel x:Name="DocumentToolbar" Margin="12,5">
    <Button x:Name="VisualEditButton" Visibility="Collapsed" Click="VisualEditClick" Padding="10,7" ToolTip="文字・矢印・線を書き込む。画像は回転・切り抜き・サイズ変更もできます。" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="画像・PDFを編集"><Canvas Width="24" Height="20"><Path Data="M4,13 L14,3 Q15,2 16,3 L19,6 Q20,7 19,8 L9,18 L3,19 Z M12,5 L17,10 M4,13 L9,18" Fill="Transparent" Stroke="{DynamicResource AiryIconStroke}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Button>
    <Button Click="OpenClick" ToolTip="開く / Open&#10;Ctrl+O" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="ファイルを開く" Padding="10,7"><Canvas Width="22" Height="20"><Path Data="M2,16 L2,5 Q2,3 4,3 L9,3 Q10,3 11,4 L13,6 L19,6 Q21,6 21,8" Fill="Transparent" Stroke="{DynamicResource AiryIconStroke}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M2,16 L5,9 Q5.5,8 7,8 L20,8 Q22,8 21.4,10 L19.5,16 Q19,18 17,18 L4,18 Q2,18 2,16 Z" Fill="Transparent" Stroke="{DynamicResource AiryIconStroke}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Button>
    <Button x:Name="PagePreviewButton" Visibility="Collapsed" Click="PagePreviewClick" ToolTip="ページの縮小一覧を開く / 閉じる" AutomationProperties.Name="ページの縮小一覧" Margin="0,0,5,0" Padding="10,7"><Canvas Width="22" Height="20"><Path Data="M2,3 H8 V8 H2 Z M11,3 H20 M11,7 H20 M2,12 H8 V17 H2 Z M11,12 H20 M11,16 H20" Fill="Transparent" Stroke="{DynamicResource AiryIconStroke}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Button>
    <Button x:Name="SaveTextButton" Visibility="Collapsed" Click="SaveTextClick" ToolTip="保存&#10;Ctrl+S" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="テキストを保存" Padding="10,7"><Canvas Width="22" Height="20"><Path Data="M3,2 L17,2 L20,5 L20,18 L3,18 Z M6,2 L6,8 L16,8 L16,2 M7,18 L7,13 L16,13 L16,18" Fill="Transparent" Stroke="{DynamicResource AiryIconStroke}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M13,4 L15,4" Stroke="{DynamicResource AiryIconStroke}" StrokeThickness="1.6" StrokeStartLineCap="Round"/></Canvas></Button>
    <Button x:Name="MarkdownModeButton" Visibility="Collapsed" Click="MarkdownModeClick" ToolTip="表示を切り替える&#10;Ctrl+Shift+M" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="Markdownのプレビューとソースを切り替える" Padding="9,7"><TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AiryInk}"/></Button>
    <Button x:Name="PrintButton" Visibility="Collapsed" Click="PrintClick" ToolTip="印刷&#10;Ctrl+P" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="印刷プレビュー" Padding="10,7"><Canvas Width="22" Height="20"><Path Data="M6,7 L6,2 L16,2 L16,7 M5,15 L3,15 Q2,15 2,14 L2,9 Q2,7 4,7 L18,7 Q20,7 20,9 L20,14 Q20,15 19,15 L17,15" Fill="Transparent" Stroke="{DynamicResource AiryIconStroke}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M6,12 L16,12 L16,18 L6,18 Z M16.5,9.5 L17,9.5" Fill="Transparent" Stroke="{DynamicResource AiryIconStroke}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Button>
    <StackPanel x:Name="PageControls" Visibility="Collapsed" Orientation="Horizontal"><Button Padding="10,7" Click="PreviousClick" ToolTip="前のページ（上へ）" AutomationProperties.Name="前のページ"><Canvas Width="24" Height="20"><Path Data="M12,18 L12,2 M5,9 L12,2 L19,9" Fill="Transparent" Stroke="{DynamicResource AiryIconStroke}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Button><TextBox x:Name="PageNumber" Text="1" Width="58" FontSize="16" TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" KeyDown="PageNumberKeyDown"/><TextBlock x:Name="PageCount" Text="/ —" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" Margin="6,0,3,0" Foreground="{DynamicResource AiryInk}"/><Button Padding="10,7" Click="NextClick" ToolTip="次のページ（下へ）" AutomationProperties.Name="次のページ"><Canvas Width="24" Height="20"><Path Data="M12,2 L12,18 M5,11 L12,18 L19,11" Fill="Transparent" Stroke="{DynamicResource AiryIconStroke}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Button></StackPanel>
    <Button Content="−" Click="ZoomOutClick" ToolTip="縮小"/><TextBox x:Name="ZoomText" Text="100" Width="84" TextAlignment="Center" VerticalContentAlignment="Center" KeyDown="ZoomInputKeyDown" LostKeyboardFocus="ZoomInputLostFocus" GotKeyboardFocus="ZoomInputGotFocus" ToolTip="表示倍率（10～800％）。入力してEnterで確定" AutomationProperties.Name="表示倍率"/><TextBlock Text="%" VerticalAlignment="Center" Foreground="{DynamicResource AiryInk}"/><Button Content="＋" Click="ZoomInClick" ToolTip="拡大"/>
    <Grid x:Name="RotationControls" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Grid.Column="0" Padding="10,7" Click="RotateLeftClick" ToolTip="左に90度回転 / Rotate left" AutomationProperties.Name="左に90度回転"><Canvas Width="24" Height="20"><Path Data="M5,10 C5,13.87 8.13,17 12,17 C15.87,17 19,13.87 19,10 C19,6.13 15.87,3 12,3 M16.5,1.5 L12,3 L16.5,4.5" Fill="Transparent" Stroke="{DynamicResource AiryIconStroke}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Button>
      <Button Grid.Column="1" Padding="10,7" Click="RotateRightClick" ToolTip="右に90度回転 / Rotate right" AutomationProperties.Name="右に90度回転"><Canvas Width="24" Height="20"><Path Data="M19,10 C19,13.87 15.87,17 12,17 C8.13,17 5,13.87 5,10 C5,6.13 8.13,3 12,3 M7.5,1.5 L12,3 L7.5,4.5" Fill="Transparent" Stroke="{DynamicResource AiryIconStroke}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Button>
      <Button x:Name="ResetRotationButton" Grid.Column="2" Padding="8,7" Click="ResetRotationClick" ToolTip="回転を0°に戻す / Reset rotation" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="回転を0度に戻す">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Canvas Width="20" Height="20"><Path Data="M3.5,10 C3.5,13.59 6.41,16.5 10,16.5 C13.59,16.5 16.5,13.59 16.5,10 C16.5,6.41 13.59,3.5 10,3.5 M14.2,2 L10,3.5 L14.2,5" Fill="Transparent" Stroke="{DynamicResource AiryIconStroke}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
          <TextBlock Text="0°" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AiryInk}" Margin="2,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid><Button x:Name="FitWidthButton" Visibility="Collapsed" Click="FitClick" ToolTip="画面幅に合わせる" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="画面幅に合わせる" Padding="10,7"><Canvas Width="24" Height="18"><Path Data="M2,2 L2,16 M22,2 L22,16 M5,9 L19,9 M8,6 L5,9 L8,12 M16,6 L19,9 L16,12" Stroke="{DynamicResource AiryIconStroke}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Button>

   </WrapPanel>
   <ScrollViewer x:Name="TabsScroller" Margin="12,0,12,3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
    <StackPanel Orientation="Horizontal">
     <TabControl x:Name="Tabs" SelectionChanged="TabChanged" MinHeight="34"/>
     <Button Content="＋" Click="NewTextClick" ToolTip="新しいメモ&#10;Ctrl+T" ToolTipService.InitialShowDelay="250" AutomationProperties.Name="新しいメモ" FontSize="20" Width="43" MinHeight="34" Padding="5,0" Margin="2,0,0,0"/>
    </StackPanel>
   </ScrollViewer>
   <DockPanel x:Name="TextSearchBar" Visibility="Collapsed" Margin="12,0,12,6" LastChildFill="False">
    <TextBox x:Name="TextSearchInput" Width="260" Padding="7,4" KeyDown="TextSearchKeyDown" GotKeyboardFocus="TextSearchGotFocus" ToolTip="文章内を検索"/>
    <Button Content="前" Click="PreviousTextMatch" Padding="9,4"/><Button Content="次" Click="NextTextMatch" Padding="9,4"/><TextBlock x:Name="TextSearchCount" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource AiryInk}"/><Button Content="×" Click="CloseTextSearch" Padding="9,4" ToolTip="検索を閉じる"/>
   </DockPanel>
   <TextBlock x:Name="Status" Visibility="Collapsed"/>
  </StackPanel>
  <Grid x:Name="ContentGrid" Background="{DynamicResource AiryCanvas}">
   <Border x:Name="PagePreviewSidebar" Visibility="Collapsed" Width="260" HorizontalAlignment="Left" Panel.ZIndex="15" Background="{DynamicResource AirySurface}" BorderBrush="{DynamicResource AiryStroke}" BorderThickness="0,0,1,0"><Grid><ScrollViewer Margin="0,0,8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PagePreviewItems" Margin="8"/></ScrollViewer><Thumb Width="8" HorizontalAlignment="Right" Cursor="SizeWE" DragDelta="PagePreviewResize" ToolTip="ドラッグして一覧の幅を変更"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource AiryStroke}"/></ControlTemplate></Thumb.Template></Thumb></Grid></Border>
   <Grid x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="820">
    <!-- Classic Welcome View -->
    <StackPanel x:Name="ClassicWelcomeView" HorizontalAlignment="Center">
     <Image x:Name="WelcomeCrane" Width="88" Height="88" Stretch="Uniform" Margin="0,0,0,24" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="AiryViewの鶴"/>
     <TextBlock Text="すっと開く。正確に印刷。" FontSize="25" Foreground="{DynamicResource AiryInk}" HorizontalAlignment="Center"/>
     <TextBlock Text="ファイルを開く" Margin="0,18,0,0" Foreground="{DynamicResource AiryInkSecondary}" HorizontalAlignment="Center"/>
     <TextBlock Text="新しいメモ：＋ または Ctrl＋T" Margin="0,10,0,0" Foreground="{DynamicResource AiryInkSecondary}" HorizontalAlignment="Center"/>
    </StackPanel>
    <!-- Modern Hero Welcome View -->
    <StackPanel x:Name="ModernWelcomeView" Visibility="Collapsed" HorizontalAlignment="Center" MaxWidth="720">
     <Border Width="100" Height="100" CornerRadius="50" Background="{DynamicResource AiryButtonBackground}" BorderBrush="{DynamicResource AiryAccent}" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,20">
      <Image x:Name="ModernWelcomeCrane" Width="66" Height="66" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
     </Border>
     <Border Background="{DynamicResource AirySurfaceSecondary}" BorderBrush="{DynamicResource AiryStroke}" BorderThickness="1" CornerRadius="12" Padding="12,3" HorizontalAlignment="Center" Margin="0,0,0,10">
      <TextBlock Text="AiryView" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AiryAccent}"/>
     </Border>
     <TextBlock Text="すっと開く。正確に印刷。" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AiryInk}" HorizontalAlignment="Center" TextAlignment="Center"/>
     <TextBlock Text="文書を開く・編集する・印刷する。" FontSize="14" Foreground="{DynamicResource AiryInkSecondary}" Margin="0,4,0,26" HorizontalAlignment="Center"/>

     <WrapPanel HorizontalAlignment="Center">
      <Button Click="OpenClick" Margin="8,6" Padding="0" Cursor="Hand" Background="{DynamicResource AirySurfaceSecondary}" BorderBrush="{DynamicResource AiryStroke}" BorderThickness="1" AutomationProperties.Name="ファイルを開くカード">
       <Border CornerRadius="12" Padding="20,16" Width="260" MinHeight="86" SnapsToDevicePixels="True">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AiryTabInactiveBackground}" BorderBrush="{DynamicResource AiryAccent}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
          <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
           <Path Data="M2,16 L2,5 Q2,3 4,3 L9,3 Q10,3 11,4 L13,6 L19,6 Q21,6 21,8" Stroke="{DynamicResource AiryAccent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
           <Path Data="M2,16 L5,9 Q5.5,8 7,8 L20,8 Q22,8 21.4,10 L19.5,16 Q19,18 17,18 L4,18 Q2,18 2,16 Z" Stroke="{DynamicResource AiryAccent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Canvas>
         </Border>
         <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <DockPanel LastChildFill="False">
           <TextBlock Text="ファイルを開く" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource AiryInk}"/>
           <Border DockPanel.Dock="Right" Background="{DynamicResource AiryTabInactiveBackground}" BorderBrush="{DynamicResource AiryStroke}" BorderThickness="1" CornerRadius="5" Padding="5,1">
            <TextBlock Text="Ctrl+O" FontSize="10" Foreground="{DynamicResource AiryInkSecondary}" FontWeight="SemiBold"/>
           </Border>
          </DockPanel>
          <TextBlock Text="PDF • 画像 • Markdown • TXT" FontSize="11" Foreground="{DynamicResource AiryInkSecondary}" Margin="0,4,0,0"/>
         </StackPanel>
        </Grid>
       </Border>
      </Button>

      <Button Click="NewTextClick" Margin="8,6" Padding="0" Cursor="Hand" Background="{DynamicResource AirySurfaceSecondary}" BorderBrush="{DynamicResource AiryStroke}" BorderThickness="1" AutomationProperties.Name="新しいメモカード">
       <Border CornerRadius="12" Padding="20,16" Width="260" MinHeight="86" SnapsToDevicePixels="True">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AiryTabInactiveBackground}" BorderBrush="{DynamicResource AiryAccent}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
          <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
           <Path Data="M4,13 L14,3 Q15,2 16,3 L19,6 Q20,7 19,8 L9,18 L3,19 Z M12,5 L17,10" Stroke="{DynamicResource AiryAccent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
          </Canvas>
         </Border>
         <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <DockPanel LastChildFill="False">
           <TextBlock Text="新しいメモ" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource AiryInk}"/>
           <Border DockPanel.Dock="Right" Background="{DynamicResource AiryTabInactiveBackground}" BorderBrush="{DynamicResource AiryStroke}" BorderThickness="1" CornerRadius="5" Padding="5,1">
            <TextBlock Text="Ctrl+T" FontSize="10" Foreground="{DynamicResource AiryInkSecondary}" FontWeight="SemiBold"/>
           </Border>
          </DockPanel>
          <TextBlock Text="白紙メモ • 素早く執筆開始" FontSize="11" Foreground="{DynamicResource AiryInkSecondary}" Margin="0,4,0,0"/>
         </StackPanel>
        </Grid>
       </Border>
      </Button>
     </WrapPanel>

     <TextBlock Text="または、ここにファイルをドラッグ＆ドロップして即座に表示" FontSize="12" Foreground="{DynamicResource AiryInkSecondary}" Margin="0,18,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
   </Grid>
   <ScrollViewer x:Name="ImageViewer" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource AiryCanvas}" PreviewMouseWheel="ImageWheel"><Image x:Name="ReaderImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="ImageClick"/></ScrollViewer>
   <Grid x:Name="TextEditorArea" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox x:Name="TextEditor" Grid.Row="0" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas, Yu Gothic UI" FontSize="15" Padding="28,22" Margin="0" BorderThickness="0" Background="{DynamicResource AiryEditorBackground}" Foreground="{DynamicResource AiryEditorForeground}" SelectionBrush="{DynamicResource AiryEditorSelection}" SelectionTextBrush="{DynamicResource AiryEditorForeground}" SelectionOpacity="{DynamicResource AiryEditorSelectionOpacity}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="TextEditorChanged" SelectionChanged="TextEditorSelectionChanged"/>
    <TextBlock Grid.Row="1" FontSize="12" Foreground="{DynamicResource AiryInkSecondary}" Background="{DynamicResource AirySurface}" Padding="28,6">ⓘ 点付きの「<Run Text="0" FontFamily="Cascadia Mono, Consolas, Yu Gothic UI" FontSize="15"/>」はフォントの見た目です。文字そのものは普通の数字の0です。</TextBlock>
   </Grid>
   <FlowDocumentScrollViewer x:Name="MarkdownViewer" Visibility="Collapsed" PreviewMouseWheel="MarkdownWheel" Background="{DynamicResource AirySurface}" VerticalScrollBarVisibility="Auto" IsSelectionEnabled="True" MinZoom="10" MaxZoom="800"/>
   <ScrollViewer x:Name="Viewer" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ViewerWheel" ScrollChanged="ViewerScrolled">
    <StackPanel x:Name="PagesHost" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Top"/>
   </ScrollViewer>
   <Border x:Name="TextSelectionBadge" Visibility="Collapsed" Panel.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,18" Padding="12,6" CornerRadius="11" Background="{DynamicResource AirySurfaceSecondary}" BorderBrush="{DynamicResource AiryStroke}" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="#000000"/></Border.Effect>
    <TextBlock x:Name="TextSelectionInfo" Foreground="{DynamicResource AiryInk}" FontFamily="Yu Gothic UI" FontSize="12" FontWeight="SemiBold"/>
   </Border>
  </Grid>
 </DockPanel>
</Window>
